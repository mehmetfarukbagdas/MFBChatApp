# Development secrets. Prefer .NET User Secrets or environment variables.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=chatapp;Username=postgres;Password=CHANGE_ME
Jwt__Key=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
Jwt__Issuer=ChatApp.API
Jwt__Audience=ChatApp.Client
Frontend__Origins=http://localhost:3000

WebPush__Subject=mailto:you@example.com
WebPush__PublicKey=YOUR_VAPID_PUBLIC_KEY
WebPush__PrivateKey=YOUR_VAPID_PRIVATE_KEY

# Comma-separated administrator email addresses.
Admin__Emails=YOUR_ADMIN_EMAIL
